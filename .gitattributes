# Normalize line endings so `just gen-check` is stable regardless of a
# contributor's core.autocrlf setting. Go and generated sources are always LF.
*.go   text eol=lf
*.sql  text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.tf   text eol=lf
*.hcl  text eol=lf
*.sh   text eol=lf
go.mod text eol=lf
go.sum text eol=lf
